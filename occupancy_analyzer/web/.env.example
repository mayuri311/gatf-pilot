# Copy to .env.local and fill in. Local values: `cd .. && supabase status -o env`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<ANON_KEY or sb_publishable_...>
SUPABASE_SERVICE_ROLE_KEY=<SERVICE_ROLE_KEY or sb_secret_...>   # server only, never exposed to the browser
READONLY_DATABASE_URL=postgresql://gatf_readonly:gatf_readonly_local@127.0.0.1:54322/postgres
# OPENAI_API_KEY is read from the repo-root .env locally; set it here or in Vercel env otherwise
# OPENAI_API_KEY=
# BOOTSTRAP_ADMIN_PASSWORD is read from the repo-root .env by scripts/bootstrap-admin.ts
# AI_MOCK=1   # offline: canned chat answers
